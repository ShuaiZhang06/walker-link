# Engine caches and local editor state
.godot/
.DS_Store
.idea/
.vscode/

# Video/audio and generated distribution packages stay outside source control.
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
*.wav
exports/
builds/

# Local credentials/configuration
.env
.env.*
!.env.example
credentials/
*.p12
*.pfx

# Git cannot ignore by size: inspect staged files before committing (>25 MB).

# ── Film reel (youtube/<slug>/) ───────────────────────────────────────────────
# Media already falls under the *.mp4 / *.mp3 / exports/ rules above and is
# handed off through the course media storage, linked from README.md.
# These are the reel's regenerable build products — recipes and evidence are
# committed, build scratch is not.
youtube/**/clips/
youtube/**/_build/
youtube/**/_stale/
youtube/**/build-state.json
youtube/**/todo.json
youtube/**/STATUS.md
youtube/**/ToDo.md
youtube/**/qc-sheet.png
youtube/**/images/
youtube/**/manim/
youtube/**/pantry/
